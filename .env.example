# LeadCore Zero v2 — Environment Variables Configuration

# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Pooled URL for application queries (port 5432 or 6543 with -pooler hostname)
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/leadcore?sslmode=require

# Direct URL for migrations and LangGraph checkpointer
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/leadcore?sslmode=require

# ── Crawler Compliance & User-Agent ─────────────────────────────────────────
# Required for Nominatim / Overpass fair use policy
CONTACT_EMAIL=crawler@example.com

# ── Optional LLM & Ollama ───────────────────────────────────────────────────
LLM_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Concurrency & Runtime ───────────────────────────────────────────────────
RUN_CONCURRENCY=2
CRAWL_CONCURRENCY=4
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Public Geospatial Endpoints ─────────────────────────────────────────────
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
OVERPASS_ENDPOINTS=https://overpass-api.de/api,https://maps.mail.ru/osm/tools/overpass/api,https://overpass.kumi.systems/api
